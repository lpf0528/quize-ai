<!--pages/book/quize/quize.wxml-->
<cu-custom bgColor="bg-gradual-blue" isBack="{{true}}">
  <view slot="content">RAG 技术测验</view>
</cu-custom>

<view class="quize-page" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <!-- 吸顶：进度 + 题干 -->
  <view class="quize-header" style="top:{{CustomBar}}px;">
    <!-- 进度 -->
    <view class="cu-bar bg-white">
      <view class="action">
        <text class="cuIcon-title text-blue"></text>
        <text class="text-bold">第 {{current + 1}} / {{total}} 题</text>
      </view>
      <view class="action text-grey">
        <text class="cuIcon-time margin-right-xs"></text>{{timeText}}
      </view>
    </view>
    <!-- <view class="bg-white padding-lr">
      <view class="cu-progress round sm">
        <view class="bg-blue" style="width:{{answeredCount / total * 100}}%;"></view>
      </view>
    </view> -->
    <!-- 题干 -->
    <view class="bg-white padding solid-bottom">
      <view class="flex align-center justify-between">
        <view class="flex-sub text-lg text-black text-bold">{{question.title}}<text class="cu-tag round {{question.type=='single'?'bg-blue':'bg-orange'}} sm margin-left-xs">{{question.typeText}}</text></view>
      </view>
      <view wx:if="{{question.type=='multiple'}}" class="text-sm text-grey margin-top-xs">（可多选，需选全才算正确）</view>
    </view>
  </view>

  <!-- 选项 -->
  <view class="padding-sm">
    <view
      wx:for="{{question.options}}"
      wx:key="key"
      class="option-item bg-white radius-lg margin-bottom-sm shadow-sm option-{{item.status}} {{!isSubmitted && item.isSelected ? 'option-picked' : ''}}"
      bindtap="chooseOption"
      data-key="{{item.key}}"
    >
      <view class="flex align-center padding">
        <view class="option-key {{question.type=='single'?'round':'radius'}}">{{item.key}}</view>
        <view class="flex-sub text-df text-black">{{item.text}}</view>
        <view wx:if="{{item.status=='right' || item.status=='correct'}}" class="cuIcon-check text-green text-xl"></view>
        <view wx:if="{{item.status=='wrong'}}" class="cuIcon-close text-red text-xl"></view>
      </view>

      <!-- 判断提示 -->
      <view wx:if="{{item.hint}}" class="option-hint padding-lr padding-bottom-sm">
        <text class="text-sm {{item.status=='wrong' ? 'text-red' : 'text-green'}}">
          <text class="{{item.status=='wrong' ? 'cuIcon-roundclose' : 'cuIcon-roundcheck'}} margin-right-xs"></text>{{item.hint}}
        </text>
      </view>

      <!-- 解析：提交后每个选项都展示 -->
      <view wx:if="{{isSubmitted}}" class="option-analysis bg-grey-light padding-sm">
        <text class="text-sm text-gray"><text class="cuIcon-info text-blue margin-right-xs"></text>{{item.analysis}}</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view wx:if="{{!isSubmitted}}" class="padding">
    <button class="cu-btn bg-blue lg block shadow radius {{canSubmit?'':'disabled'}}" bindtap="submit">提交</button>
  </view>

  <!-- 滑动提示 -->
  <view class="text-center text-sm text-grey padding-bottom">
    <text class="cuIcon-back margin-right-xs"></text>右滑上一题 · 左滑下一题<text class="cuIcon-right margin-left-xs"></text>
  </view>
</view>

<!-- 悬浮查看结果按钮：全部答完后展示在右侧中间 -->
<view wx:if="{{allSubmitted}}" class="result-fab bg-gradual-green shadow-lg" bindtap="goResult">
  <text class="cuIcon-medal"></text>
  <view class="text-xs">查看结果</view>
</view>

<!-- 悬浮答题卡按钮：可拖动 -->
<view
  class="answer-fab shadow-lg {{fabDragging ? '' : 'answer-fab-anim'}}"
  style="left:{{fabX}}px; top:{{fabY}}px;"
  catchtouchstart="onFabTouchStart"
  catchtouchmove="onFabTouchMove"
  catchtouchend="onFabTouchEnd"
>
  <!-- 水位层：高度随已作答进度上升 -->
  <view class="fab-water" style="height:{{answeredCount / total * 100}}%;">
    <view class="fab-wave"></view>
    <view class="fab-wave fab-wave-2"></view>
  </view>
  <view class="fab-content">
    <text class="cuIcon-list"></text>
    <view class="text-xs">{{answeredCount}}/{{total}}</view>
  </view>
</view>

<!-- 答题卡弹窗 -->
<view class="cu-modal {{showCard ? 'show' : ''}}" bindtap="closeCard">
  <view class="cu-dialog" catchtap>
    <view class="cu-bar bg-white justify-end">
      <view class="content text-bold">答题卡</view>
      <view class="action text-blue" bindtap="closeCard">
        <text class="cuIcon-close"></text>
      </view>
    </view>
    <view class="padding bg-white">
      <view class="answer-grid">
        <view
          wx:for="{{cardItems}}"
          wx:key="index"
          class="answer-cell cell-{{item.status}} {{item.index == current ? 'current' : ''}}"
          bindtap="jumpTo"
          data-index="{{item.index}}"
        >{{item.index + 1}}</view>
      </view>
      <view class="flex flex-wrap justify-center align-center margin-top text-sm text-grey">
        <view class="flex align-center margin-right margin-bottom-xs">
          <view class="legend-dot cell-none"></view>未选择
        </view>
        <view class="flex align-center margin-right margin-bottom-xs">
          <view class="legend-dot cell-selected"></view>已选择
        </view>
        <view class="flex align-center margin-right margin-bottom-xs">
          <view class="legend-dot cell-right"></view>正确
        </view>
        <view class="flex align-center margin-bottom-xs">
          <view class="legend-dot cell-wrong"></view>错误
        </view>
      </view>

      <!-- 全部选择完成后：一键提交 -->
      <view wx:if="{{answeredCount == total && !allSubmitted}}" class="margin-top">
        <button class="cu-btn bg-blue lg block shadow radius" bindtap="submitAll">
          <text class="cuIcon-check margin-right-xs"></text>一键提交
        </button>
      </view>
    </view>
  </view>
</view>
