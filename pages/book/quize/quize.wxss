/* pages/book/quize/quize.wxss */
.quize-page {
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* 吸顶：进度 + 题干 */
.quize-header {
  position: sticky;
  z-index: 100;
  background-color: #fff;
}

/* 选项容器 */
.option-item {
  overflow: hidden;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

/* 选项序号 */
.option-key {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  margin-right: 24rpx;
  background-color: #f1f1f1;
  color: #666;
  font-weight: bold;
  flex-shrink: 0;
}

/* 未提交：选中态 */
.option-picked {
  border-color: #0081ff;
}

.option-picked .option-key {
  background-color: #0081ff;
  color: #fff;
}

/* 提交后：回答正确 / 正确答案 -> 绿色 */
.option-right,
.option-correct {
  border-color: #39b54a;
  background-color: #f0faf1 !important;
}

.option-right .option-key,
.option-correct .option-key {
  background-color: #39b54a;
  color: #fff;
}

/* 提交后：回答错误 -> 红色 */
.option-wrong {
  border-color: #e54d42;
  background-color: #fdf1f0 !important;
}

.option-wrong .option-key {
  background-color: #e54d42;
  color: #fff;
}

/* 解析区 */
.bg-grey-light {
  background-color: #f7f7f7;
}

.option-analysis {
  border-top: 2rpx dashed #e0e0e0;
  line-height: 1.6;
}

.option-hint {
  line-height: 1.4;
}

/* 悬浮答题卡按钮 */
.answer-fab {
  position: fixed;
  z-index: 900;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.1;
}

.answer-fab .cuIcon-list {
  font-size: 40rpx;
}

.answer-fab-anim {
  transition: left 0.2s ease, top 0.2s ease;
}

/* 悬浮查看结果按钮：右侧垂直居中 */
.result-fab {
  position: fixed;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 900;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

.result-fab .cuIcon-medal {
  font-size: 44rpx;
}

/* 答题卡网格 */
.answer-grid {
  display: flex;
  flex-wrap: wrap;
}

.answer-cell {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 12rpx;
  margin: 0 20rpx 20rpx 0;
  font-weight: bold;
}

.answer-cell.answered {
  background-color: #39b54a;
  color: #fff;
}

.answer-cell.unanswered {
  background-color: #f1f1f1;
  color: #999;
}

.answer-cell.current {
  box-shadow: 0 0 0 4rpx #0081ff;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.legend-dot.answered {
  background-color: #39b54a;
}

.legend-dot.unanswered {
  background-color: #f1f1f1;
}
