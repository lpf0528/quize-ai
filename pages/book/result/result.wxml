<!--pages/book/result/result.wxml-->
<cu-custom bgColor="bg-gradual-blue" isBack="{{true}}">
  <view slot="content">测验结果</view>
</cu-custom>

<view class="result-page">
  <!-- 环形图 -->
  <view class="bg-white radius-lg margin shadow-sm padding-tb">
    <view class="chart-wrap">
      <ec-canvas id="result-chart" canvas-id="result-chart" ec="{{ ec }}"></ec-canvas>
    </view>
  </view>

  <!-- 统计卡片：图标 + 文字 -->
  <view class="flex margin-lr text-center">
    <view class="flex-sub bg-white radius-lg margin-xs shadow-sm padding-tb">
      <view class="cuIcon-check text-green stat-icon"></view>
      <view class="text-xxl text-green text-bold">{{correct}}</view>
      <view class="text-sm text-gray">答对</view>
    </view>
    <view class="flex-sub bg-white radius-lg margin-xs shadow-sm padding-tb">
      <view class="cuIcon-close text-red stat-icon"></view>
      <view class="text-xxl text-red text-bold">{{wrong}}</view>
      <view class="text-sm text-gray">答错</view>
    </view>
    <view class="flex-sub bg-white radius-lg margin-xs shadow-sm padding-tb">
      <view class="cuIcon-time text-blue stat-icon"></view>
      <view class="text-xxl text-blue text-bold">{{timeText}}</view>
      <view class="text-sm text-gray">用时</view>
    </view>
  </view>

  <!-- 未答提示 -->
  <view wx:if="{{unanswered > 0}}" class="bg-white radius-lg margin shadow-sm padding flex align-center justify-between">
    <view>
      <text class="cuIcon-remind text-orange margin-right-xs"></text>
      <text class="text-df text-black">未作答</text>
    </view>
    <text class="text-xl text-orange text-bold">{{unanswered}} 题</text>
  </view>

  <!-- 操作按钮 -->
  <view class="padding">
    <button class="cu-btn bg-blue lg block shadow radius margin-bottom" bindtap="retry">再测一次</button>
    <button class="cu-btn line-blue lg block radius" bindtap="backBook">返回书籍</button>
  </view>

  <view class="cu-tabbar-height"></view>
</view>
